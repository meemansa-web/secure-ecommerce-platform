# ========================================================
# MODIMAL LIVE SMS & EMAIL GATEWAY CONFIGURATION
# ========================================================

# 1. Real SMS to Indian Mobile Numbers (+91)
# Sign up free at https://www.fast2sms.com to get your Dev API Key
VITE_FAST2SMS_API_KEY=

# 2. Alternative International SMS via Twilio
VITE_TWILIO_SID=
VITE_TWILIO_TOKEN=
VITE_TWILIO_FROM=

# 3. Real Email Delivery to Inboxes (EmailJS / Web3Forms)
# Sign up free at https://www.emailjs.com
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Or free instant email key from https://web3forms.com
VITE_WEB3FORMS_KEY=
